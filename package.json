{
  "private": true,
  "scripts": {
    "build": "npm --prefix frontend run build",
    "vercel:install": "npm --prefix frontend install",
    "vercel:build": "npm --prefix frontend run build && rm -rf build && cp -R frontend/build build",
    "postinstall": "npm --prefix backend install",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "perf:summary": "node performance-tests/generate-summary.mjs performance-tests/report.json performance-tests/report-summary.md"
  },
  "dependencies": {
    "twilio": "^5.12.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
